{
  "family": "foro-frontend-angular-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::975050265328:role/LabRole",
  "containerDefinitions": [
    {
      "name": "foro-frontend-angular",
      "image": "975050265328.dkr.ecr.us-east-1.amazonaws.com/foro-frontend-angular:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "80" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/foro-frontend-angular",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
